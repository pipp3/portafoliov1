---
interface Role {
  company: string;
  position: string;
  period: string;
  year: string;
  location?: string;
  description: string;
  technologies: string[];
  impact?: { n: string; label: string };
  current?: boolean;
}

const roles: Role[] = [
  {
    company: 'Dinámica Plataforma',
    position: 'Desarrollador Full-Stack',
    period: 'Mayo 2026 — presente',
    year: '2026',
    location: 'Santiago, CL',
    description:
      'Desarrollo y mantengo plataformas web a medida para clientes, de punta a punta: levanto requerimientos, construyo con Next.js, despliego y doy soporte continuo. En paralelo integro IA en mi flujo de trabajo y <b>automaticé tareas y pipelines internos de la empresa</b>, lo que me permite iterar más rápido y entregar con más consistencia.',
    technologies: ['Next.js', 'React', 'IA aplicada', 'Automatización'],
    current: true,
  },
  {
    company: 'Think Mining+',
    position: 'Desarrollador Full-Stack',
    period: 'Ene — Feb 2026',
    year: '2026',
    description:
      'Refactoricé un backend Python completo: reorganicé carpetas y scripts para que el proyecto se pudiera mantener y crecer. Optimicé una plataforma de monitoreo en Next.js aplicando SSR, y construí el módulo de reportería junto a la <b>edición de mapas con Mapbox</b>.',
    technologies: ['Python', 'Next.js', 'Mapbox', 'SSR', 'TypeScript'],
    impact: { n: 'SSR', label: 'Render en servidor para el monitoreo' },
  },
  {
    company: 'Reneé',
    position: 'Desarrollador Full-Stack',
    period: 'Jun — Nov 2025',
    year: '2025',
    description:
      'Lideré el desarrollo de una plataforma psicométrica que digitalizó el proceso de reclutamiento. API REST en Express sobre MySQL, frontend en React + TypeScript. <b>El tiempo de evaluación manual bajó un 60%.</b>',
    technologies: ['React', 'TypeScript', 'Express', 'MySQL', 'Node.js'],
    impact: { n: '−60%', label: 'Tiempo de evaluación manual' },
  },
  {
    company: 'Precision',
    position: 'Desarrollador Full-Stack',
    period: 'Dic 2023 — Feb 2024',
    year: '2023',
    description:
      'Diseñé e implementé un sistema automatizado de cotizaciones integrado con HubSpot CRM: de un proceso manual a uno digital de punta a punta. Backend en Google Apps Script con BigQuery y una API REST contra SQL Server. <b>El procesamiento cayó un 75%.</b>',
    technologies: ['Apps Script', 'BigQuery', 'SQL Server', 'HubSpot', 'jQuery'],
    impact: { n: '−75%', label: 'Tiempo de procesamiento' },
  },
];
---

<section id="experiencia" class="experience">
  <div class="shell">
    <div class="head">
      <div>
        <p class="kicker"><b class="mono">03 — Experiencia</b><span class="rule"></span></p>
        <h2 class="mask-line"><span>Trayectoria</span></h2>
      </div>
      <p class="meta mono" data-reveal>
        <span>Dic 2023 <em class="lit">→</em> hoy</span>
        <span>{roles.length} equipos · Santiago, CL</span>
      </p>
    </div>

    <div class="track">
      <span class="rail" data-draw aria-hidden="true"><span class="fill"></span></span>

      <ol class="items">
      {roles.map((role, i) => (
        <li class="item" data-reveal="blur" style={`--rev-d:${140 + i * 110}ms`}>
          <span class="year mono" aria-hidden="true">{role.year}</span>
          <span class="node" aria-hidden="true"></span>

          <div class="body">
            <div class="top">
              <h3 class="dsp">{role.company}</h3>
              {role.current && <span class="now mono">Actual</span>}
            </div>

            <p class="role mono">
              <span>{role.position}</span>
              <i aria-hidden="true"></i>
              <span>{role.period}</span>
              {role.location && (<><i aria-hidden="true"></i><span>{role.location}</span></>)}
            </p>

            <p class="desc" set:html={role.description} />

            {role.technologies.length > 0 && (
              <ul class="chips" aria-label="Tecnologías">
                {role.technologies.map((t) => <li class="chip"><span>{t}</span></li>)}
              </ul>
            )}
          </div>

          {role.impact && (
            <div class="impact">
              <b class="dsp">{role.impact.n}</b>
              <span class="mono">{role.impact.label}</span>
            </div>
          )}
        </li>
      ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .experience { position: relative; padding: clamp(80px, 11vw, 132px) 0; background: var(--bg-2); }

  .head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: clamp(36px, 5vw, 58px);
  }
  h2 { font-size: clamp(40px, 6.4vw, 72px); }
  .meta {
    text-align: right;
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--faint);
    line-height: 2;
    margin: 0;
    flex: 0 0 auto;
  }
  .meta span { display: block; }
  .meta em { font-style: normal; }
  .lit { color: var(--lit); }

  /* Un solo riel continuo, no un segmento por tarjeta. */
  .track { position: relative; padding-left: 34px; }
  .items { list-style: none; margin: 0; padding: 0; }
  .rail {
    display: block;
    position: absolute;
    left: 6px; top: 12px; bottom: 30px;
    width: 1px;
    background: var(--hair);
  }
  .fill {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, var(--lit), var(--cy) 45%, var(--deep));
    box-shadow: 0 0 10px color-mix(in srgb, var(--lit) 55%, transparent);
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 1600ms var(--ease-expo) 200ms;
  }
  .rail.is-in .fill { transform: scaleY(1); }

  /* Donde el navegador lo soporta, el riel se dibuja con el scroll. */
  @supports (animation-timeline: view()) {
    .fill {
      transition: none;
      animation: rail-draw linear both;
      animation-timeline: view();
      animation-range: cover 8% cover 72%;
    }
    @keyframes rail-draw { to { transform: scaleY(1); } }
  }

  .item { position: relative; padding: 0 0 clamp(36px, 5vw, 50px); }

  .node {
    position: absolute;
    left: -34px; top: 10px;
    width: 13px; height: 13px;
    border-radius: 50%;
    background: var(--border);
    border: 1px solid var(--border);
    transition: background-color var(--t-row) var(--ease-std), border-color var(--t-row) var(--ease-std);
  }
  .item.is-in .node { background: var(--lit); border-color: var(--lit); }
  .node::after {
    content: '';
    position: absolute;
    inset: -6px;
    border-radius: 50%;
    border: 1px solid var(--lit);
    opacity: 0;
  }
  .item.is-in .node::after { animation: node-ping 900ms var(--ease-expo) 200ms 1; }
  @keyframes node-ping {
    0% { transform: scale(0.5); opacity: 1; }
    100% { transform: scale(2.6); opacity: 0; }
  }

  .year { display: none; }

  .top { display: flex; align-items: baseline; flex-wrap: wrap; gap: 14px; margin-bottom: 6px; }
  h3 { font-size: clamp(26px, 3.8vw, 38px); font-weight: 700; letter-spacing: -0.035em; line-height: 1.1; }
  .now {
    font-size: 9.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--solid-fg);
    background: var(--solid-bg);
    border-radius: 999px;
    padding: 4px 10px;
    font-weight: 600;
    animation: now-glow 2.6s ease-in-out infinite;
  }
  @keyframes now-glow {
    0%, 100% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--solid-bg) 45%, transparent); }
    50% { box-shadow: 0 0 0 7px transparent; }
  }

  .role {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    margin: 0 0 14px;
    font-size: 11.5px;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--faint);
  }
  .role i { width: 3px; height: 3px; border-radius: 50%; background: currentColor; }

  .desc {
    margin: 0 0 16px;
    font-size: 15.5px;
    line-height: 1.66;
    color: var(--muted);
    max-width: 68ch;
    text-wrap: pretty;
  }
  .desc :global(b) { color: var(--fg); font-weight: 600; }

  .chips { display: flex; flex-wrap: wrap; gap: 7px; list-style: none; margin: 0; padding: 0; }

  .impact { margin-top: 20px; border-left: 1px solid var(--hair); padding-left: 20px; }
  .impact b {
    display: block;
    font-size: clamp(32px, 4vw, 46px);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1;
    color: var(--lit);
  }
  .impact span {
    display: block;
    margin-top: 8px;
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--faint);
    line-height: 1.8;
  }

  @media (min-width: 1000px) {
    .track { padding-left: 126px; }
    .rail { left: 78px; }
    .node { left: -54px; }
    .year {
      display: block;
      position: absolute;
      left: -126px; top: 6px;
      width: 62px;
      text-align: right;
      font-size: 12px;
      letter-spacing: 0.08em;
      color: var(--faint);
    }
    .item { display: grid; grid-template-columns: 1fr 214px; gap: 44px; align-items: start; }
    .impact { margin-top: 4px; padding-left: 24px; }
  }
</style>
