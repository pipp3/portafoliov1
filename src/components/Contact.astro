---

<section id="contacto" class="contact">
  <div class="ambient" aria-hidden="true"><div class="aura center"></div></div>

  <div class="shell">
    <p class="kicker"><b class="mono">05 — Contacto</b><span class="rule"></span></p>

    <div class="grid">
      <div class="left">
        <h2 class="mask-line"><span>Hablemos.</span></h2>

        <a href={`mailto:${email}`} class="mail">
          {email.split('').map((c, i) => (
            <span style={`--i:${i}`}>{c}</span>
          ))}
          <i aria-hidden="true"></i>
        </a>

        <p class="avail">
          <span class="pip" aria-hidden="true"></span>
          <span class="mono">Respondo en menos de 24 horas</span>
        </p>

        <ul class="socials" data-stagger="tight">
          {socials.map((s) => (
            <li data-reveal>
              <a href={s.url} target="_blank" rel="noopener noreferrer">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d={s.path} /></svg>
                {s.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <form id="contact-form" class="form" novalidate data-reveal style="--rev-d:120ms">
        <div class="fh">
          <b class="mono">Mensaje directo</b>
          <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
        </div>

        <input class="hp" name="_honeypot" tabindex="-1" autocomplete="off" aria-hidden="true" />

        <div class="field">
          <input type="text" id="name" name="name" placeholder=" " autocomplete="name" required />
          <label for="name">Nombre</label>
          <span class="line" aria-hidden="true"></span>
          <p class="err" id="error-name" aria-live="polite"></p>
        </div>

        <div class="field">
          <input type="email" id="email" name="email" placeholder=" " autocomplete="email" required />
          <label for="email">Email</label>
          <span class="line" aria-hidden="true"></span>
          <p class="err" id="error-email" aria-live="polite"></p>
        </div>

        <div class="field">
          <textarea id="message" name="message" rows="4" placeholder=" " required></textarea>
          <label for="message">Mensaje</label>
          <span class="line" aria-hidden="true"></span>
          <p class="err" id="error-message" aria-live="polite"></p>
        </div>

        <button type="submit" class="submit" aria-busy="false">
          <span class="s idle">Enviar mensaje <b class="arw" aria-hidden="true">→</b></span>
          <span class="s busy"><i class="spin" aria-hidden="true"></i> Enviando…</span>
          <span class="s ok">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12.5 9.5 18 20 6.5" /></svg>
            Mensaje enviado
          </span>
        </button>

        <p class="status mono" id="form-status" role="status"></p>
      </form>
    </div>
  </div>
</section>

<style>
  .contact { position: relative; padding: clamp(80px, 11vw, 132px) 0 clamp(60px, 7vw, 90px); overflow: hidden; }
  .aura.center { left: 50%; top: 80px; margin-left: -490px; }

  .grid { display: grid; grid-template-columns: 1fr; gap: clamp(44px, 6vw, 88px); align-items: start; }

  h2 { font-size: clamp(52px, 9vw, 96px); margin-bottom: 30px; letter-spacing: -0.05em; }

  /* Cada carácter salta con 22 ms de retardo acumulado. */
  .mail {
    display: block;
    width: fit-content;
    max-width: 100%;
    position: relative;
    font-size: clamp(18px, 3.4vw, 31px);
    font-weight: 600;
    letter-spacing: -0.03em;
    color: var(--fg);
    padding-bottom: 12px;
    margin-bottom: 30px;
    word-break: break-all;
  }
  .mail span {
    display: inline-block;
    transition: transform var(--t-btn) var(--ease-spring), color var(--t-btn) var(--ease-std);
    transition-delay: calc(var(--i) * 22ms);
  }
  .mail:hover span,
  .mail:focus-visible span { transform: translateY(-8px); color: var(--lit); }
  .mail i {
    position: absolute;
    left: 0; bottom: 0;
    height: 2px;
    width: 100%;
    background: var(--lit);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform var(--t-row) var(--ease-expo);
  }
  .mail:hover i,
  .mail:focus-visible i { transform: scaleX(1); transform-origin: left; }

  .avail {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    margin: 0 0 34px;
    border: 1px solid color-mix(in srgb, var(--cy) 32%, transparent);
    background: color-mix(in srgb, var(--cy) 8%, transparent);
    border-radius: 999px;
    padding: 8px 16px 8px 12px;
  }
  .avail .mono { font-size: 10.5px; letter-spacing: 0.17em; text-transform: uppercase; color: var(--lit); }

  .socials { display: flex; flex-wrap: wrap; gap: 10px; list-style: none; margin: 0; padding: 0; }
  .socials a {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 46px;
    padding: 0 20px;
    border: 1px solid var(--border);
    border-radius: 10px;
    font-size: 13px;
    color: var(--fg);
    transition: transform var(--t-btn) var(--ease-spring), border-color var(--t-btn) var(--ease-std), background-color var(--t-btn) var(--ease-std);
  }
  .socials a svg { width: 17px; height: 17px; fill: var(--faint); transition: fill var(--t-btn) var(--ease-std); }
  .socials a:hover {
    transform: translateY(-4px);
    border-color: var(--cy);
    background: color-mix(in srgb, var(--cy) 12%, transparent);
    color: var(--fg);
  }
  .socials a:hover svg { fill: var(--lit); }

  /* ── formulario ─────────────────────────────────────────── */
  .form {
    background: color-mix(in srgb, var(--card) 70%, transparent);
    border: 1px solid var(--hair);
    border-radius: 18px;
    padding: clamp(22px, 3vw, 34px);
    backdrop-filter: blur(10px);
    box-shadow: 0 34px 70px rgba(0, 0, 0, 0.16);
  }
  .fh { display: flex; align-items: center; justify-content: space-between; margin-bottom: 24px; }
  .fh b { font-size: 11px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--faint); font-weight: 500; }
  .dots { display: flex; gap: 5px; }
  .dots i { width: 7px; height: 7px; border-radius: 50%; background: var(--border); }
  .dots i:first-child { background: var(--cy); }

  .hp { position: absolute; opacity: 0; pointer-events: none; height: 0; width: 0; }

  .field { position: relative; margin-bottom: 12px; padding-top: 18px; }
  .field input,
  .field textarea {
    width: 100%;
    background: none;
    border: 0;
    border-bottom: 1px solid var(--border);
    padding: 12px 0;
    font: inherit;
    font-size: 15px;
    color: var(--fg);
    border-radius: 0;
  }
  .field textarea { resize: vertical; min-height: 84px; }
  .field input:focus,
  .field textarea:focus { outline: none; }

  /* Etiqueta flotante nativa: :placeholder-shown, sin JS. */
  .field label {
    position: absolute;
    left: 0; top: 30px;
    font-size: 15px;
    color: var(--faint);
    pointer-events: none;
    transform-origin: left center;
    transition: transform var(--t-btn) var(--ease-expo), color var(--t-btn) var(--ease-std);
  }
  .field input:focus + label,
  .field textarea:focus + label,
  .field input:not(:placeholder-shown) + label,
  .field textarea:not(:placeholder-shown) + label {
    transform: translateY(-26px) scale(0.72);
    color: var(--lit);
  }

  /* La línea se dibuja desde la izquierda al enfocar. */
  .field .line {
    position: absolute;
    left: 0;
    bottom: 22px;
    height: 1.5px;
    width: 100%;
    background: var(--lit);
    box-shadow: 0 0 10px color-mix(in srgb, var(--lit) 60%, transparent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--t-btn) var(--ease-expo);
  }
  .field input:focus ~ .line,
  .field textarea:focus ~ .line { transform: scaleX(1); }

  .err {
    margin: 6px 0 0;
    min-height: 14px;
    font-size: 12.5px;
    color: #dc2626;
  }
  :global(.dark) .err { color: #f87171; }
  .field.bad input,
  .field.bad textarea { border-bottom-color: #dc2626; }

  .submit {
    position: relative;
    overflow: hidden;
    width: 100%;
    min-height: 52px;
    border: 0;
    border-radius: 10px;
    background: var(--solid-bg);
    color: var(--solid-fg);
    font: inherit;
    font-weight: 600;
    font-size: 15px;
    cursor: pointer;
    display: grid;
    transition: background-color var(--t-btn) var(--ease-std);
  }
  .submit:hover:not(:disabled) { background: var(--solid-hover); }
  .submit:disabled { cursor: default; }
  .submit .s {
    grid-area: 1 / 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    opacity: 0;
    transform: translateY(6px);
    transition: opacity var(--t-btn) var(--ease-std), transform var(--t-btn) var(--ease-expo);
  }
  .submit .idle { opacity: 1; transform: none; }
  .submit[data-state='busy'] .idle,
  .submit[data-state='ok'] .idle { opacity: 0; transform: translateY(-6px); }
  .submit[data-state='busy'] .busy { opacity: 1; transform: none; }
  .submit[data-state='ok'] .ok { opacity: 1; transform: none; }
  .submit .arw { transition: transform var(--t-btn) var(--ease-expo); }
  .submit:hover .arw { transform: translateX(5px); }
  .submit .ok svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 2.6; stroke-linecap: round; stroke-linejoin: round; }
  .spin {
    width: 15px; height: 15px;
    border: 2px solid color-mix(in srgb, currentColor 30%, transparent);
    border-top-color: currentColor;
    border-radius: 50%;
    animation: spin 0.7s linear infinite;
  }
  @keyframes spin { to { transform: rotate(360deg); } }

  .status {
    margin: 14px 0 0;
    min-height: 18px;
    font-size: 11.5px;
    letter-spacing: 0.08em;
    color: var(--faint);
  }
  .status.ok { color: var(--lit); }
  .status.bad { color: #dc2626; }
  :global(.dark) .status.bad { color: #f87171; }

  @media (min-width: 960px) {
    .grid { grid-template-columns: 1fr 452px; }
  }
</style>

<script>
  import emailjs from '@emailjs/browser';

  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const button = form?.querySelector<HTMLButtonElement>('.submit');
  const status = document.getElementById('form-status');

  const COOLDOWN_MS = 30_000;
  let lastSent = 0;

  const rules = {
    name: (v: string) => (v.length < 2 ? 'El nombre debe tener al menos 2 caracteres.' : ''),
    email: (v: string) => (/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v) ? '' : 'Ingresa un email válido.'),
    message: (v: string) => (v.length < 10 ? 'El mensaje debe tener al menos 10 caracteres.' : ''),
  } as const;

  function setError(field: keyof typeof rules, message: string) {
    const input = form?.querySelector<HTMLElement>(`[name="${field}"]`);
    const slot = document.getElementById(`error-${field}`);
    if (slot) slot.textContent = message;
    input?.closest('.field')?.classList.toggle('bad', Boolean(message));
  }

  function validate() {
    let ok = true;
    for (const field of Object.keys(rules) as (keyof typeof rules)[]) {
      const input = form?.querySelector<HTMLInputElement>(`[name="${field}"]`);
      const message = rules[field](input?.value.trim() ?? '');
      setError(field, message);
      if (message) ok = false;
    }
    return ok;
  }

  function say(text: string, tone: '' | 'ok' | 'bad' = '') {
    if (!status) return;
    status.textContent = text;
    status.className = `status mono ${tone}`;
  }

  function state(value: 'idle' | 'busy' | 'ok') {
    if (!button) return;
    button.dataset.state = value;
    button.disabled = value !== 'idle';
    button.setAttribute('aria-busy', String(value === 'busy'));
  }

  function reason(error: { status?: number }) {
    if (error.status === 429) return 'Demasiadas solicitudes. Espera unos minutos.';
    if (error.status === 400) return 'Los datos del formulario no son válidos.';
    if (error.status === 403) return 'No tienes permiso para enviar este mensaje.';
    if (!navigator.onLine) return 'Sin conexión. Verifica tu red e intenta de nuevo.';
    return 'No se pudo enviar. Intenta nuevamente más tarde.';
  }

  if (form && button) {
    emailjs.init(import.meta.env.PUBLIC_EMAILJS_PUBLIC_KEY);

    // Limpia el error en cuanto el campo se corrige.
    for (const field of Object.keys(rules) as (keyof typeof rules)[]) {
      form.querySelector(`[name="${field}"]`)?.addEventListener('input', () => setError(field, ''));
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      if (form.querySelector<HTMLInputElement>('[name="_honeypot"]')?.value) return;

      const waiting = COOLDOWN_MS - (Date.now() - lastSent);
      if (waiting > 0) {
        const seconds = Math.ceil(waiting / 1000);
        say(`Espera ${seconds} segundo${seconds === 1 ? '' : 's'} antes de volver a enviar.`, 'bad');
        return;
      }

      if (!validate()) {
        say('Revisa los campos marcados.', 'bad');
        return;
      }

      state('busy');
      say('');

      try {
        await emailjs.sendForm(
          import.meta.env.PUBLIC_EMAILJS_SERVICE_ID,
          import.meta.env.PUBLIC_EMAILJS_TEMPLATE_ID,
          form,
          import.meta.env.PUBLIC_EMAILJS_PUBLIC_KEY
        );
        lastSent = Date.now();
        state('ok');
        say('Gracias. Te respondo dentro de las próximas 24 horas.', 'ok');
        form.reset();
        setTimeout(() => state('idle'), 2600);
      } catch (error) {
        state('idle');
        say(reason(error as { status?: number }), 'bad');
        console.error('EmailJS error:', error);
      }
    });
  }
</script>
